// SPDX-License-Identifier: MIT

// The download CTA for the flagship GAIA agent, OS-detected.
//
// Two things are on offer and they are not the same product-shape:
//
//   1. The ONE-CLICK INSTALLER — a GitHub Release asset built by
//      .github/workflows/build-flagship-installers.yml. It bundles the terminal
//      UI, the frozen agent sidecar, and (on Windows) Lemonade Server, puts
//      everything on PATH, and needs nothing else installed first. This is what
//      the primary button points at whenever the release actually carries one
//      for the visitor's platform.
//   2. The RAW BINARY — the terminal UI on its own, from the hub. It lands in
//      Downloads with no PATH entry, no agent behind it, and no local model. It
//      stays reachable for people who want exactly that, one disclosure away
//      and labelled as the advanced path.
//
// Why the installer is resolved in the browser and the raw list at build time:
// the raw binaries come from the hub manifest, which is a hard build-time
// dependency the site already fails loudly on (see data/catalog.ts). The
// installers live on a GitHub Release that may not carry them yet, and a
// missing asset must NOT fail the site build or render a dead button. So the
// list below is always rendered server-side and always works; the installer is
// a progressive enhancement that promotes itself over the list once it exists.
//
// Before the first release cuts an installer: the visitor sees exactly what
// they see today — the raw binary for their platform, plus every platform.
// After: the installer becomes the primary button and the raw list collapses
// into "Advanced — no installer".

import { getComponentRelease, formatBytes } from '../data/catalog';
import { PLATFORM_LABELS, type PlatformKey } from '../scripts/download-target';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const release = await getComponentRelease('terminal-hub');

// Order the list the way a visitor scans for their own machine.
const ORDER: PlatformKey[] = [
  'win-x64',
  'darwin-arm64',
  'linux-x64',
  'win-arm64',
  'darwin-x64',
  'linux-arm64',
];

const platformOf = (filename: string): PlatformKey =>
  filename.replace(/^gaia-/, '').replace(/\.exe$/, '') as PlatformKey;

const downloads = release.binaries
  .map((b) => ({ ...b, platform: platformOf(b.filename) }))
  .filter((b) => b.platform in PLATFORM_LABELS)
  .sort((a, b) => ORDER.indexOf(a.platform) - ORDER.indexOf(b.platform));
---

<div class:list={['min-w-0', className]} data-tui-download>
  <div class="flex flex-wrap items-center gap-3">
    {/* The installer CTA. Hidden until JS confirms the release publishes one
        for this machine — never rendered with a placeholder href, so it cannot
        become a dead button. */}
    <a data-dl-installer hidden class="g-btn g-btn-primary px-6 py-3 text-[15px]">
      <svg class="h-4 w-4 flex-none" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      <span data-dl-installer-label>Download the GAIA installer</span>
    </a>

    {/* The raw-binary CTA. Also hidden until JS places the machine — it is the
        primary only while no installer exists for this platform. */}
    <a
      data-dl-primary
      hidden
      href={downloads[0]?.url}
      class="g-btn g-btn-primary px-6 py-3 text-[15px]"
    >
      <svg class="h-4 w-4 flex-none" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      <span data-dl-label>Install the GAIA agent</span>
    </a>

    <span data-dl-meta class="mono text-[11.5px] text-g-faint" hidden></span>
  </div>

  {/* The second installer format, where a platform has one (Linux's AppImage
      next to its .deb). Hidden unless it is actually offered. */}
  <a data-dl-installer-alt hidden class="mono mt-3 inline-flex items-baseline gap-2 text-[12.5px] text-g-muted transition-colors hover:text-g-gold-text">
    <span class="text-g-gold-text" aria-hidden="true">↓</span>
    <span data-dl-installer-alt-label></span>
  </a>

  <div data-dl-list class="mt-4">
    <div class="g-label mb-2.5" data-dl-list-label>Download for your platform · v{release.version}</div>
    <ul class="grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
      {downloads.map((d) => (
        <li>
          <a
            href={d.url}
            data-dl-option
            data-platform={d.platform}
            data-filename={d.filename}
            data-size={formatBytes(d.size_bytes)}
            class="group inline-flex items-baseline gap-2 text-[13.5px] text-g-muted transition-colors hover:text-g-gold-text"
          >
            <span class="text-g-gold-text" aria-hidden="true">↓</span>
            <span>{PLATFORM_LABELS[d.platform]}</span>
            <span class="mono text-[11px] text-g-faint">{formatBytes(d.size_bytes)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  {/* Which of these two notes applies depends on what the visitor is being
      offered, so both are rendered and the script shows one. */}
  <p data-note-installer hidden class="mt-3.5 max-w-[520px] text-[12.5px] leading-[1.6] text-g-faint">
    One file. It installs the GAIA agent and its terminal UI and puts
    <code class="bg-transparent p-0">gaia-tui</code> on your
    <code class="bg-transparent p-0">PATH</code> — no Python, no Node, no repo clone.
    Run <code class="bg-transparent p-0">gaia-tui</code> when it finishes. On Windows
    it installs the local model server too; on macOS and Linux that is
    <a href="https://amd-gaia.ai/docs/guides/install-agent" class="prose-link">one more step</a>.
    Nothing is code-signed yet, so your OS will ask once:
    see <a href="https://amd-gaia.ai/docs/guides/install-agent#first-launch-warnings" class="prose-link">first-launch warnings</a>.
  </p>

  <p data-note-raw class="mt-3.5 max-w-[520px] text-[12.5px] leading-[1.6] text-g-faint">
    The GAIA agent runs on your machine and you talk to it in the terminal. Rename the
    download to <code class="bg-transparent p-0">gaia-tui</code>, put it on your
    <code class="bg-transparent p-0">PATH</code>, and run it. It needs the
    <code class="bg-transparent p-0">gaia</code> CLI for the local model, which the
    <a href="#terminal-install" class="prose-link">one-line installer</a> sets up for you.
  </p>
</div>

<style>
  /* The CTAs carry .g-btn, whose display:inline-flex outranks the user agent's
     [hidden] { display: none }. Without this the buttons this component hides
     until JS places the machine are laid out anyway, and a no-JS visitor gets a
     stack of duplicate buttons. */
  [hidden] {
    display: none !important;
  }
</style>

<script>
  import {
    findInstallers,
    resolvePlatform,
    PLATFORM_LABELS,
    type ReleaseAssetLike,
  } from '../scripts/download-target';

  const LATEST_RELEASE = 'https://api.github.com/repos/amd/gaia/releases/latest';

  document.querySelectorAll<HTMLElement>('[data-tui-download]').forEach(async (root) => {
    const options = Array.from(
      root.querySelectorAll<HTMLAnchorElement>('[data-dl-option]')
    );
    if (!options.length) return;

    // Start the release lookup immediately, but never await it before the raw
    // path is on screen. api.github.com is unauthenticated here, so it can be
    // rate-limited, slow, or blocked outright — and a visitor staring at no
    // button at all while that resolves is worse than one who briefly sees the
    // binary and then gets offered the installer. A failure of any kind means
    // "no installer", which is the same outcome as a release that has not
    // published one yet.
    const installerPromise = fetch(LATEST_RELEASE)
      .then((r) => (r.ok ? r.json() : null))
      .then((rel) => (rel?.assets ?? []) as ReleaseAssetLike[])
      .catch(() => [] as ReleaseAssetLike[]);

    const platform = await resolvePlatform(navigator).catch(() => null);
    if (!platform) return;   // Unplaceable machine: the full list stays as-is.

    const match = options.find((o) => o.dataset.platform === platform);
    const meta = root.querySelector<HTMLElement>('[data-dl-meta]');
    const list = root.querySelector<HTMLElement>('[data-dl-list]');
    const listLabel = root.querySelector('[data-dl-list-label]');
    const version = listLabel?.textContent?.split('v').pop() ?? '';

    // Collapse the full platform list behind a disclosure, labelled for whichever
    // path is currently secondary. Runs once; the label is rewritten in place if
    // an installer arrives afterwards.
    let summaryEl: HTMLElement | null = null;
    const collapseList = (summaryText: string) => {
      if (summaryEl) {
        summaryEl.textContent = summaryText;
        return;
      }
      if (!list || !listLabel) return;
      const details = document.createElement('details');
      details.className = 'mt-4';
      const summary = document.createElement('summary');
      summary.className =
        'g-label cursor-pointer list-none transition-colors hover:text-g-text';
      summary.textContent = summaryText;
      list.replaceWith(details);
      details.append(summary, list);
      listLabel.remove();
      summaryEl = summary;
    };

    // Step 1 — the raw binary, on screen now. This is the whole interface until
    // a release publishes an installer, and it stays the fallback afterwards for
    // any platform the installer matrix does not cover.
    const rawPrimary = root.querySelector<HTMLAnchorElement>('[data-dl-primary]');
    const rawLabel = root.querySelector('[data-dl-label]');
    if (match && rawPrimary && rawLabel) {
      rawPrimary.href = match.href;
      rawLabel.textContent = `Install GAIA for ${PLATFORM_LABELS[platform]}`;
      rawPrimary.hidden = false;
      if (meta) {
        meta.textContent = `${match.dataset.filename} · ${match.dataset.size}`;
        meta.hidden = false;
      }
      collapseList(`Other platforms · v${version}`);
    }

    // Step 2 — promote the installer over it, if the release carries one.
    const installers = findInstallers(platform, await installerPromise);
    if (!installers.length) return;

    const [primary, ...rest] = installers;
    const button = root.querySelector<HTMLAnchorElement>('[data-dl-installer]');
    const label = root.querySelector('[data-dl-installer-label]');
    if (!button || !label) return;

    button.href = primary.url;
    label.textContent = `Download GAIA for ${PLATFORM_LABELS[platform]}`;
    button.hidden = false;
    if (rawPrimary) rawPrimary.hidden = true;
    if (meta) {
      meta.textContent = `${primary.label} · ${primary.name}`;
      meta.hidden = false;
    }

    const alt = root.querySelector<HTMLAnchorElement>('[data-dl-installer-alt]');
    const altLabel = root.querySelector('[data-dl-installer-alt-label]');
    if (rest[0] && alt && altLabel) {
      alt.href = rest[0].url;
      altLabel.textContent = `${rest[0].label} instead`;
      alt.hidden = false;
    }

    root.querySelector<HTMLElement>('[data-note-raw]')?.setAttribute('hidden', '');
    root.querySelector<HTMLElement>('[data-note-installer]')?.removeAttribute('hidden');
    collapseList('Advanced — no installer, just the binary');
  });
</script>
