// One tile in the landing page's two grid sections — what it can do, and how
// it is built. Both use this component, so the two grids cannot drift into
// different type sizes, measures, or spacing.
//
// Each tile is a card with an icon chip, matching the "three ways in" cards so
// the page speaks one visual language top to bottom.
//
// `link` closes the sentence with a credit or reference (e.g. the Lemonade
// backend); the trailing period belongs to the component, not the copy, so a
// tile with a link and one without end identically.

import AgentIcon from './AgentIcon.astro';

interface Props {
  icon: string;
  title: string;
  body: string;
  link?: { label: string; href: string; emoji?: string };
}

const { icon, title, body, link } = Astro.props;
---

<li class="g-card g-card-lift flex flex-col p-[22px]">
  <span class="g-chip mb-4 h-9 w-9 border-g-border2">
    <AgentIcon name={icon} class="h-[18px] w-[18px]" />
  </span>
  <h3 class="font-display text-[16.5px] font-semibold leading-[1.35] tracking-[-0.01em] text-g-text">
    {title}
  </h3>
  <p class="g-body mt-2 text-[14px] leading-[1.65]">
    {body}{link && (
      <>
        {' '}
        {/* One line on purpose: a newline inside the anchor renders as a
            space before the period ("Lemonade ."). */}
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="prose-link whitespace-nowrap">{link.emoji && <span aria-hidden="true">{link.emoji + ' '}</span>}{link.label}</a>.
      </>
    )}
  </p>
</li>
