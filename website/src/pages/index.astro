// Copyright(C) 2024-2026 Advanced Micro Devices, Inc. All rights reserved.
// SPDX-License-Identifier: MIT

// The landing page has exactly one job: get a visitor to install the GAIA agent
// and put it to work. One product, one install, one entry point — so the page
// carries one primary CTA and no competing paths, and the only branch it offers
// is what you do with that one agent: run it, integrate it, build on it.

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InstallCommand from '../components/InstallCommand.astro';
import TuiDownload from '../components/TuiDownload.astro';
import Feature from '../components/Feature.astro';
import Eyebrow from '../components/Eyebrow.astro';
import WayCard from '../components/WayCard.astro';

const DOCS = 'https://amd-gaia.ai/docs';

// Three things you can do with the one agent — not three products.
const PATHS = [
  {
    n: '01',
    icon: 'cpu',
    who: 'For everyone',
    title: 'Run it',
    body: 'Give it a task over your files, your data, or your code — it runs locally.',
    code: 'gaia-tui',
    cta: 'Quickstart',
    href: `${DOCS}/quickstart`,
    external: true,
  },
  {
    n: '02',
    icon: 'package',
    who: 'For app teams',
    title: 'Integrate it',
    body: 'Embed the agent in your app as a local sidecar.',
    code: 'npm install @amd-gaia/gaia',
    // The npm page, not ${DOCS}/guides/gaia: that guide is not on main yet, so
    // the docs site 404s it. The package is published (0.1.0) and its README is
    // the integration reference until the guide ships.
    cta: 'Package on npm',
    href: 'https://www.npmjs.com/package/@amd-gaia/gaia',
    external: true,
  },
  {
    n: '03',
    icon: 'code',
    who: 'For developers',
    title: 'Build on it',
    body: 'Add a skill, or publish your own agent to the hub.',
    code: 'gaia skill create <name>',
    cta: 'Custom agent guide',
    href: `${DOCS}/guides/custom-agent`,
    external: true,
  },
];

// Only what the flagship agent actually exposes through the TUI today. Its
// config is prompt_profile="full" — doc_rag + file_fs + data_scratch +
// web_browse — plus the code index and the skill library, and every tool call
// goes through the TUI's approval gate. Voice and image generation are NOT in
// this list on purpose: neither ships in the TUI, and `enable_sd_tools` is off
// by design (a second resident model would evict the chat model).
const CAPABILITIES = [
  {
    icon: 'file',
    title: 'Answers from your documents',
    body: 'PDFs and notes indexed on the machine, never uploaded.',
  },
  {
    icon: 'folder',
    title: 'Reads and edits your files',
    body: 'Scoped to your home folder, with the rest of the disk off limits.',
  },
  {
    // Real catalog: Google + Microsoft OAuth and the GitHub / Tavily / Memory /
    // Git MCP servers (src/gaia/connectors/catalog/), gated by per-agent grants.
    icon: 'send',
    title: 'Connects to your apps',
    body: 'Google and Microsoft sign-in, plus MCP servers like GitHub and Tavily — each unlocked per agent, with scopes you grant.',
  },
  {
    icon: 'table',
    title: 'Works your spreadsheets',
    body: 'CSV and Excel loaded into a local SQL scratchpad it can query.',
  },
  {
    icon: 'globe',
    title: 'Looks things up on the web',
    body: 'Searches and reads pages when a task needs something it does not have.',
  },
  {
    icon: 'clipboard',
    title: 'Asks before it acts',
    body: 'Every tool call needs your approval until you decide otherwise.',
  },
];

// Why it is built this way. Every line is a real property of the system: the
// NPU path through Lemonade, the single resident model and its per-device
// context window, memory plus retrieval instead of compaction, runtime-loaded
// signed skills, the shared tool-mixin registry, and opt-in-only remote models.
const ARCHITECTURE = [
  {
    icon: 'cpu',
    title: 'The AI chip in your PC does the work',
    body: 'Models run on the NPU and integrated graphics of a Ryzen™ AI machine, served locally by',
    link: { label: 'Lemonade', href: 'https://lemonade-server.ai/', emoji: '🍋' },
  },
  {
    icon: 'box',
    title: 'One model stays loaded',
    body: 'Every agent and skill shares it, so switching between them costs nothing.',
  },
  {
    icon: 'bot',
    title: 'It remembers instead of forgetting',
    body: 'Memory and a local index of your files — not a summary of your history.',
  },
  {
    icon: 'package',
    title: 'Skills, not more installs',
    body: 'Small signed packages the agent picks up and puts down while it runs.',
  },
  {
    // gaia-agent.yaml: api_server true (mcp_server false — client only, so the
    // page claims the API, not an MCP server). Routes in src/gaia/api/.
    icon: 'route',
    title: 'Any OpenAI client can call it',
    body: 'The agent serves the OpenAI chat API locally, so existing SDKs and apps switch to it with a base-URL change.',
  },
  {
    icon: 'route',
    title: 'No silent cloud fallback',
    body: 'A remote model is something you switch on for a run, never a default.',
  },
];
---

<Layout
  title="GAIA — the agent for AI PCs"
  description="GAIA is AMD's open-source AI agent for AI PCs. It runs entirely on your own hardware — no cloud, no token costs, and your data never leaves the machine."
>
  <Header />
  <main id="main-content">
    <!-- 1. Hero — the claim, then the one install. A product demo belongs here
         and will return as a real recording; the scripted stand-in was removed
         rather than left on the page pretending to be one. -->
    <section id="install" class="g-shell flex flex-col items-center pb-24 pt-[136px] text-center sm:pb-32 sm:pt-[184px]">
      <h1 class="g-h-hero animate-g-rise max-w-[14ch]">
        The agent for<br /><span class="whitespace-nowrap text-g-gold-text">AI PCs.</span>
      </h1>

      <p class="g-lede animate-g-rise mt-6 text-center" style="animation-delay:0.08s">
        GAIA runs entirely on your own hardware. No cloud, no token costs,
        no data leaving your machine &mdash; it even works air-gapped.
      </p>

      <TuiDownload align="center" class="animate-g-rise mt-10 [animation-delay:0.14s]" />
    </section>

    <!-- 2. The whole product, in three cards. -->
    <section id="build" class="g-shell g-section scroll-mt-[66px]">
      <div class="mb-11 flex flex-wrap items-end justify-between gap-6">
        <div>
          <Eyebrow class="mb-3.5">Three ways in</Eyebrow>
          <h2 class="g-h-section">One agent.<br />Three ways to use it.</h2>
        </div>
        <p class="g-lede-sm max-w-[360px]">
          Whether you never open a terminal or you live in one, the same local agent does the
          work.
        </p>
      </div>

      <div class="grid gap-[18px] md:grid-cols-3">
        {PATHS.map((p) => <WayCard {...p} />)}
      </div>
    </section>

    <!-- 3. What it can do, and why it is built that way. One card shape for
         both, so the page reads as one grid, twice. -->
    <section id="features" class="g-shell g-section scroll-mt-[66px] border-t border-g-border">
      <div class="mb-11 flex flex-wrap items-end justify-between gap-6">
        <div>
          <Eyebrow class="mb-3.5">What it can do</Eyebrow>
          <h2 class="g-h-section">Real work,<br />all on-device.</h2>
        </div>
        <p class="g-lede-sm max-w-[360px]">
          Documents, files, code, data, and the web — with your approval gating every tool call.
        </p>
      </div>
      <ul class="grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3">
        {CAPABILITIES.map((f) => <Feature {...f} />)}
      </ul>
    </section>

    <section id="architecture" class="g-shell g-section scroll-mt-[66px] border-t border-g-border">
      <div class="mb-11 flex flex-wrap items-end justify-between gap-6">
        <div>
          <Eyebrow class="mb-3.5">Under the hood</Eyebrow>
          <h2 class="g-h-section">Built local-first,<br />on purpose.</h2>
        </div>
        <p class="g-lede-sm max-w-[360px]">
          Every card below is a real property of the system, not a roadmap item.
        </p>
      </div>
      <ul class="grid gap-[18px] sm:grid-cols-2 lg:grid-cols-3">
        {ARCHITECTURE.map((f) => <Feature {...f} />)}
      </ul>
    </section>

    <!-- 3. The terminal install, for people who would rather not click a
         download at all. -->
    <section id="terminal-install" class="scroll-mt-[66px] border-t border-g-border">
      <div class="g-shell py-16 text-center sm:py-[88px]">
        <h2 class="g-h-cta mx-auto max-w-[720px]">Or install it from the terminal.</h2>
        <InstallCommand align="center" class="mt-8" />
      </div>
    </section>

    <!-- 5. The contributor CTA. Last on the page on purpose: it is the ask for
         the small share of visitors who came to build rather than install. -->
    <section id="contribute" class="border-t border-g-border">
      <div class="g-shell flex flex-wrap items-center justify-between gap-7 py-14">
        <div>
          <h2 class="font-display text-[22px] font-semibold tracking-[-0.02em] text-g-text">
            Built in the open.
          </h2>
          <p class="g-body mt-2.5 max-w-[520px] text-[14.5px] leading-[1.7]">
            GAIA is MIT-licensed and developed on GitHub. Agents, skills, bug reports and
            fixes are all welcome — some issues are tagged for first-time contributors.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="https://github.com/amd/gaia"
            target="_blank"
            rel="noopener noreferrer"
            class="g-btn g-btn-secondary whitespace-nowrap"
          >
            <svg class="h-[17px] w-[17px] flex-none" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
            Contribute on GitHub
          </a>
          <a
            href="https://github.com/amd/gaia/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22"
            target="_blank"
            rel="noopener noreferrer"
            class="g-cta-link"
          >Good first issues<span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
