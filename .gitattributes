# Binary test fixtures — prevent LF/CRLF mangling
cpp/tests/fixtures/*.png binary
cpp/tests/fixtures/*.jpg binary

# content_digest hashes these fixture bytes raw (#2468), so an autocrlf checkout
# would change the hash and fail the vectors on Windows only.
tests/fixtures/skill_audit_digest/** -text

# Chunk-boundary fixtures are a byte-exact cross-runtime contract; a CRLF
# checkout rewrites the documents the committed chunks were generated from.
cpp/tests/fixtures/chunking/* -text

# Vendored third-party sources — never ours to reformat, lint, or review.
# linguist-vendored keeps them out of language stats; -diff keeps a 9 MB
# amalgamation out of every diff that touches the directory.
cpp/third_party/** linguist-vendored
cpp/third_party/sqlite/sqlite3.c -diff
cpp/third_party/sqlite/sqlite3.h -diff

# Every email-agent PR appends an [Unreleased] bullet to this changelog;
# without a union merge, sibling PRs merged close together conflict on the
# same insertion point.
hub/agents/email/python/CHANGELOG.md merge=union

# gaia eval fixtures: the POSIX gh shim needs an LF shebang everywhere, and the
# fixture-hub zips' sha256s are pinned in their manifests — keep both byte-exact.
tests/fixtures/gaia/fake_gh/gh eol=lf
tests/fixtures/gaia/fixture_hub/**/*.zip binary

# Shell scripts are LF in the blob. Git checks them out CRLF on Windows
# under core.autocrlf, which is fine for CI (it reads the blob) but breaks
# a container that mounts the working tree -- this keeps the two the same.
*.sh text eol=lf

# Debian maintainer scripts have no extension, so the *.sh rule misses them.
# A CRLF postrm is a broken postrm on the target machine.
installer/tui/linux/postrm text eol=lf
